# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Amplify (static CDN): .env.example is copied to .env.production on every build
# (see amplify.yml). Only NEXT_PUBLIC_* values are baked into the static export.
# Override any value in Amplify → App settings → Environment variables.

# PostHog analytics — optional
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Contact form webhook (IslaIntel Waves) — called from the browser
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=https://waves.islaintel.com/api/v1/webhooks/S2bgx5mxtevAMOyUCunRR

# Registration form webhook (IslaIntel Waves → Google Sheet) — called from the browser
NEXT_PUBLIC_REGISTER_WEBHOOK_URL=https://waves.islaintel.com/api/v1/webhooks/oQwh7JAcfDrZ8CgUvymgO

# Stripe Payment Links (hosted checkout — no Amplify SSR required)
# Create a $199 product Payment Link in Stripe Dashboard.
# Prefer one link per player count (locked quantity):
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_1=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_2=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_3=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_4=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_5=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_6=
# Or a single adjustable-quantity link (parent must set quantity on Stripe):
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# After payment, redirect to: https://1ball1game.org/register/?paid=1
# (optional: append &session_id={CHECKOUT_SESSION_ID} if your link supports it)

# Optional: server-side webhook worker (/server) + Resend notifications
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# REGISTER_EMAIL_FROM=1 Ball 1 Game Registration <registration@1ball1game.org>
