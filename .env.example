# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Amplify: .env.example is copied to .env.production on every build (see amplify.yml).
# Override any value in Amplify → App settings → Environment variables.

# PostHog analytics — optional
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Contact form webhook (IslaIntel Waves)
CONTACT_WEBHOOK_URL=https://waves.islaintel.com/api/v1/webhooks/S2bgx5mxtevAMOyUCunRR

# Registration form webhook (IslaIntel Waves → Google Sheet)
REGISTER_WEBHOOK_URL=https://waves.islaintel.com/api/v1/webhooks/oQwh7JAcfDrZ8CgUvymgO

# Stripe — required for registration payment on step 6
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from Stripe → Developers → Webhooks → endpoint
# Endpoint URL: https://1ball1game.org/api/stripe/webhook
# Events: payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=

# Optional: direct registration notification email (parent + info@1ball1game.org)
# If unset, notification relies on REGISTER_WEBHOOK_URL / Waves workflow.
RESEND_API_KEY=
REGISTER_EMAIL_FROM=1 Ball 1 Game Registration <registration@1ball1game.org>
